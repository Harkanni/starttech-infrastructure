aws_region = "us-west-2"
azs        = ["us-west-2a", "us-west-2b"]

# Must match the alb.ingress.kubernetes.io/load-balancer-name annotation
# set on the k8s Ingress in the application repo, so Terraform's data
# source can find the ALB by name once it's created.
alb_load_balancer_name = "starttech-alb"
